# WHUforum local development environment template.
# Copy this file to ".env" and fill only the secrets you personally need.
# Never commit ".env" or real cloud/email/API credentials.

# === Docker Compose / Local Dev ===
COMPOSE_PROJECT_NAME=whuforum
ENV_FILE=../.env
NUXT_ENV=dev
SPRING_HEALTH_PATH=/actuator/health
WS_HEALTH_PATH=/actuator/health

# === Core Service Ports ===
SERVER_PORT=8080
FRONTEND_PORT=3000
WEBSOCKET_PORT=8082
OPENISLE_MCP_PORT=8085
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/

# === Database Configuration ===
# Full Docker Compose uses service hostnames. If you run backend on the host
# machine, change MYSQL_HOST/REDIS_HOST/RABBITMQ_HOST to localhost in your .env.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=openisle
MYSQL_USER=openisle
MYSQL_PASSWORD=openisle
MYSQL_ROOT_PASSWORD=openisle

# === Redis Configuration ===
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASS=

# === RabbitMQ Configuration ===
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=nagisa
RABBITMQ_PASSWORD=nagisa

# === OpenSearch Configuration ===
# Search is optional for local development.
OPENSEARCH_ENABLED=false
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_METRICS_PORT=9600
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_SCHEME=http
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
SEARCH_ENABLED=false
SEARCH_INDEX_PREFIX=openisle
SEARCH_HIGHLIGHT_FRAGMENT_SIZE=200
SEARCH_REINDEX_ON_STARTUP=false
SEARCH_REINDEX_BATCH_SIZE=500

# === Backend Application Secrets ===
# Replace these in .env for any shared/staging environment.
JWT_SECRET=change-me-dev-jwt-secret
JWT_REASON_SECRET=change-me-dev-jwt-reason-secret
JWT_RESET_SECRET=change-me-dev-jwt-reset-secret
JWT_INVITE_SECRET=change-me-dev-jwt-invite-secret
JWT_EXPIRATION=2592000000
JWT_RESET_EXPIRATION=1800000
PASSWORD_STRENGTH=LOW

# === Backend Feature Flags ===
POST_PUBLISH_MODE=DIRECT
REGISTER_MODE=DIRECT
UPLOAD_CHECK_TYPE=true
UPLOAD_MAX_SIZE=5242880
AVATAR_STYLE=pixel-art-neutral
AVATAR_SIZE=128
AVATAR_BASE_URL=https://api.dicebear.com/6.x
USER_POSTS_LIMIT=10
USER_REPLIES_LIMIT=50
SNIPPET_LENGTH=200
WHU_MODE=true
WHU_IDENTITY_HASH_SALT=change-me-dev-whu-identity-salt
WHU_IDENTITY_ENCRYPTION_KEY=
WHU_INIT_CATEGORIES=true
MODERATION_BLOCKED_WORDS=
MODERATION_CRISIS_WORDS=
AI_FORMAT_LIMIT=3
LOG_LEVEL=INFO
LOG_PATH=logs
MESSAGING_LOG_LEVEL=DEBUG
WEBSOCKET_LOG_LEVEL=DEBUG

# === Captcha ===
CAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
CAPTCHA_REGISTER_ENABLED=false
CAPTCHA_LOGIN_ENABLED=false
CAPTCHA_POST_ENABLED=false
CAPTCHA_COMMENT_ENABLED=false

# === Email ===
# Choose one provider: resend, smtp, or tencent-ses.
# Email sending requires real credentials in your local .env.
EMAIL_PROVIDER=tencent-ses
EMAIL_FROM_NAME=WHUforum
EMAIL_VERIFICATION_TOKEN_EXPIRATION_MINUTES=1440

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_AUTH=true
SMTP_STARTTLS_ENABLE=true
SMTP_SSL_ENABLE=false
SMTP_CONNECTION_TIMEOUT=10000
SMTP_TIMEOUT=10000
SMTP_WRITE_TIMEOUT=10000

# Tencent Cloud SES
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_ENDPOINT=ses.tencentcloudapi.com
TENCENT_SES_FROM_EMAIL=
TENCENT_SES_TEMPLATE_ID=
TENCENT_SES_REGISTER_TEMPLATE_ID=
TENCENT_SES_RESET_TEMPLATE_ID=
TENCENT_SES_TEST_TEMPLATE_ID=
TENCENT_SES_REPLY_TO=
TENCENT_SES_TRIGGER_TYPE=1

# === Tencent COS / Image Upload ===
COS_BASE_URL=https://example.com
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET_NAME=

# === OpenAI / Bot Optional Settings ===
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENISLE_TOKEN=
APIFY_API_TOKEN=
DAILY_NEWS_CATEGORY_ID=6
DAILY_NEWS_TAG_IDS=3,33

# === Website / Web Push ===
WEBSITE_URL=http://localhost:3000
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# === Frontend (Nuxt) ===
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080
NUXT_PUBLIC_API_BASE_URL_SSR=http://localhost:8080
NUXT_PUBLIC_WEBSOCKET_URL=http://localhost:8082
NUXT_PUBLIC_WEBSITE_BASE_URL=http://localhost:3000

# === MCP Server ===
OPENISLE_MCP_BACKEND_BASE_URL=http://springboot:8080
OPENISLE_MCP_HOST=0.0.0.0
OPENISLE_MCP_PORT=8085
OPENISLE_MCP_TRANSPORT=streamable-http
OPENISLE_MCP_REQUEST_TIMEOUT=10.0
OPENISLE_MCP_ACCESS_TOKEN=
OPENISLE_MCP_LOG_LEVEL=INFO

# === Docs ===
OPENAPI_INPUT=http://localhost:8080/api/v3/api-docs
